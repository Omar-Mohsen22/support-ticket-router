# Copy this file to .env and fill in real values. Never commit .env.

# step-04: src/ticket_router/predictors/api_predictor.py (OpenAI zero-shot baseline)
# OPENAI_BASE_URL defaults to https://api.openai.com/v1 in code if left blank --
# only set it here to point at a different OpenAI-compatible endpoint.
# OPENAI_MODEL has NO default: it must be set here, never hardcoded in the script.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# step-06: src/ticket_router/make_sft_dataset.py -- the QLoRA fine-tuning
# target (open-weights, self-hosted later), NOT the same thing as
# OPENAI_MODEL above (that's only for the hosted zero-shot/few-shot
# baselines). Defaults to Qwen/Qwen2.5-1.5B-Instruct in code if left blank.
FT_BASE_MODEL=

# step-15: src/ticket_router/predictors/adapter_predictor.py -- a Hugging Face
# token with READ access. The fine-tuned adapter repo (train/config.yaml's
# hub_model_id) is public since step 31, so any valid read token works. No
# default; the script STOPs with a clear message if this is unset.
HF_TOKEN=
